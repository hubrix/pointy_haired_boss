{
   "name": "pointy-haired-boss",
   "version": "0.0.0",
   "private": true,
   "type": "module",
   "description": "Shared prose contracts and development spikes for Pointy Haired Boss",
   "engines": {
      "node": ">=22.18.0"
   },
   "scripts": {
      "test": "node scripts/export-schemas.mjs --check && node --test test/contracts/*.test.mjs spikes/parser/*.test.mjs",
      "schemas": "node scripts/export-schemas.mjs",
      "spike:parser": "node spikes/parser/compare.mjs",
      "spike:dsh": "node spikes/hosts/dsh.mjs"
   },
   "devDependencies": {
      "@textlint/kernel": "15.8.0",
      "@textlint/textlint-plugin-markdown": "15.8.0",
      "compromise": "14.17.0",
      "remark-frontmatter": "5.0.0",
      "remark-gfm": "4.0.1",
      "remark-math": "6.0.0",
      "remark-parse": "11.0.0",
      "unified": "11.0.5"
   },
   "dependencies": {
      "ajv": "8.20.0",
      "picomatch": "4.0.7"
   }
}
