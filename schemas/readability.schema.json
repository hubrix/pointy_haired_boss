{
   "type": "object",
   "properties": {
      "version": {
         "const": 1
      },
      "inputHash": {
         "type": "string",
         "pattern": "^[a-f0-9]{64}$"
      },
      "metric": {
         "const": "flesch-kincaid"
      },
      "method": {
         "const": "phb-english-1"
      },
      "sentenceParser": {
         "const": "parse-english@7.0.0"
      },
      "syllableEstimator": {
         "const": "syllable@5.0.1"
      },
      "status": {
         "enum": [
            "disabled",
            "incomplete-boundaries",
            "no-eligible-prose",
            "unsupported-tokens",
            "insufficient-sample",
            "measured"
         ]
      },
      "reason": {
         "type": "string",
         "minLength": 1,
         "pattern": "\\S"
      },
      "targetMaxGrade": {
         "type": "number",
         "minimum": 0,
         "maximum": 30
      },
      "minWords": {
         "type": "integer",
         "minimum": 1
      },
      "words": {
         "type": "integer",
         "minimum": 0
      },
      "sentences": {
         "type": "integer",
         "minimum": 0
      },
      "syllables": {
         "anyOf": [
            {
               "type": "integer",
               "minimum": 0
            },
            {
               "type": "null"
            }
         ]
      },
      "grade": {
         "type": [
            "number",
            "null"
         ]
      },
      "aboveTarget": {
         "type": [
            "boolean",
            "null"
         ]
      },
      "units": {
         "type": "array",
         "items": {
            "type": "object",
            "properties": {
               "range": {
                  "type": "object",
                  "properties": {
                     "start": {
                        "type": "integer",
                        "minimum": 0
                     },
                     "end": {
                        "type": "integer",
                        "minimum": 0
                     }
                  },
                  "required": [
                     "start",
                     "end"
                  ],
                  "additionalProperties": false
               },
               "anchor": {
                  "type": "object",
                  "properties": {
                     "start": {
                        "type": "integer",
                        "minimum": 0
                     },
                     "end": {
                        "type": "integer",
                        "minimum": 0
                     }
                  },
                  "required": [
                     "start",
                     "end"
                  ],
                  "additionalProperties": false
               },
               "words": {
                  "type": "integer",
                  "minimum": 1
               },
               "syllables": {
                  "anyOf": [
                     {
                        "type": "integer",
                        "minimum": 0
                     },
                     {
                        "type": "null"
                     }
                  ]
               }
            },
            "required": [
               "range",
               "anchor",
               "words",
               "syllables"
            ],
            "additionalProperties": false
         }
      },
      "excluded": {
         "type": "object",
         "properties": {
            "structure": {
               "type": "integer",
               "minimum": 0
            },
            "protected": {
               "type": "integer",
               "minimum": 0
            },
            "selection": {
               "type": "integer",
               "minimum": 0
            },
            "fragment": {
               "type": "integer",
               "minimum": 0
            },
            "suppression": {
               "type": "integer",
               "minimum": 0
            },
            "empty": {
               "type": "integer",
               "minimum": 0
            }
         },
         "required": [
            "structure",
            "protected",
            "selection",
            "fragment",
            "suppression",
            "empty"
         ],
         "additionalProperties": false
      },
      "unsupportedTokens": {
         "type": "array",
         "items": {
            "type": "object",
            "properties": {
               "span": {
                  "type": "object",
                  "properties": {
                     "start": {
                        "type": "integer",
                        "minimum": 0
                     },
                     "end": {
                        "type": "integer",
                        "minimum": 0
                     },
                     "text": {
                        "type": "string"
                     },
                     "startLocation": {
                        "type": "object",
                        "properties": {
                           "line": {
                              "type": "integer",
                              "minimum": 1
                           },
                           "column": {
                              "type": "integer",
                              "minimum": 1
                           }
                        },
                        "required": [
                           "line",
                           "column"
                        ],
                        "additionalProperties": false
                     },
                     "endLocation": {
                        "type": "object",
                        "properties": {
                           "line": {
                              "type": "integer",
                              "minimum": 1
                           },
                           "column": {
                              "type": "integer",
                              "minimum": 1
                           }
                        },
                        "required": [
                           "line",
                           "column"
                        ],
                        "additionalProperties": false
                     }
                  },
                  "required": [
                     "start",
                     "end",
                     "text",
                     "startLocation",
                     "endLocation"
                  ],
                  "additionalProperties": false
               },
               "reason": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
               }
            },
            "required": [
               "span",
               "reason"
            ],
            "additionalProperties": false
         }
      }
   },
   "required": [
      "version",
      "inputHash",
      "metric",
      "method",
      "sentenceParser",
      "syllableEstimator",
      "status",
      "reason",
      "targetMaxGrade",
      "minWords",
      "words",
      "sentences",
      "syllables",
      "grade",
      "aboveTarget",
      "units",
      "excluded",
      "unsupportedTokens"
   ],
   "additionalProperties": false,
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "$id": "urn:phb:readability:v1",
   "title": "PHB readability v1"
}
